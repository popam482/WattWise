# Copy to .env before docker compose up
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=wattwise

# Optional — chat falls back to keyword replies if unset
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Must be >= 32 characters
JWT_SECRET=WattWiseSuperSecretKeyForJWTAuth2026SecureMinimum32Chars!
JWT_EXPIRATION_MS=86400000

# --- WattWise notifications (optional; leave blank to disable a channel) ---
WATTWISE_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
WATTWISE_MAIL_FROM=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_AUTH=
