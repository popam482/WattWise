# Copy to .env before docker compose up
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=ecodispatch

# Optional — chat falls back to keyword replies if unset
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Must be >= 32 characters
JWT_SECRET=EcoDispatchSuperSecretKeyForJWTAuth2026SecureMinimum32Chars!
JWT_EXPIRATION_MS=86400000
